# SmashSense Environment Variables Template
# Copy this file to .env.local to configure local overrides (never commit real .env files)

# Public Application URL (used for canonical URLs and social share metadata)
VITE_APP_URL=https://smashsense.vercel.app

# Optional: Google Gemini API Key for AI Coaching Summaries
# Users can also input their own key in the application UI settings (stored in localStorage)
VITE_GEMINI_API_KEY=

# Optional: Sentry DSN for client-side crash monitoring
VITE_SENTRY_DSN=

# Optional: Privacy-friendly analytics identifier (e.g., Plausible domain or Vercel Analytics)
VITE_ANALYTICS_ID=
